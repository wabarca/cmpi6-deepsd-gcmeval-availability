# ==============================================================================
# Plantilla de variables privadas para download_preprocess_cmip6.sh
# Copia este archivo como .env y completa tus valores locales.
# El archivo .env está excluido en .gitignore y no se sincroniza con Git.
# ==============================================================================

ENABLE_REMOTE_SYNC=true
REMOTE_HOST=
REMOTE_USER=
REMOTE_DEST_DIR=

# Credenciales opcionales de Copernicus CDS para descargar ERA5 (o usar ~/.cdsapirc / ./.cdsapirc)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
